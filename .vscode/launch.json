{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension (Desktop)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ]
        },
        {
            "name": "Run Extension (Web / VS Code Online)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensionDevelopmentKind=web"
            ]
        }
    ]
}
